import mysql.connector

conn = mysql.connector.connect(
    host="localhost",
    user="root",
    password="your_password",
    database="fraud_detection"
)
cursor = conn.cursor()

while True:
    print("\n1. Add transaction")
    print("2. View flagged transactions")
    print("3. Exit")
    choice = input("Choose: ")

    if choice == "1":
        account_id = input("Account ID: ")
        card_id = input("Card ID: ")
        device_id = input("Device ID: ")
        amount = input("Amount: ")
        location = input("Location: ")

        cursor.execute(
            "INSERT INTO Transactions (account_id, card_id, device_id, amount, location) VALUES (%s, %s, %s, %s, %s)",
            (account_id, card_id, device_id, amount, location)
        )
        conn.commit()
        print("Transaction added. Trigger checked it for fraud automatically.")

    elif choice == "2":
        cursor.execute(
            "SELECT u.name, t.txn_id, t.amount, f.rule_triggered, f.severity "
            "FROM FraudFlags f "
            "JOIN Transactions t ON f.txn_id = t.txn_id "
            "JOIN Accounts a ON t.account_id = a.account_id "
            "JOIN Users u ON a.user_id = u.user_id"
        )
        for row in cursor.fetchall():
            print(row)

    elif choice == "3":
        break

conn.close()
